{
    "swagger": "2.0",
    "info": {
        "description": "Сервис асинхронных котировок валютных курсов.",
        "title": "Currencies API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/quotes": {
            "post": {
                "description": "Регистрирует асинхронный запрос обновления котировки валютной пары и возвращает его идентификатор.\nПовторный вызов с той же парой при незавершённом запросе возвращает существующий идентификатор.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Обновить котировку",
                "parameters": [
                    {
                        "type": "string",
                        "example": "EUR/MXN",
                        "description": "Валютная пара BASE/QUOTE",
                        "name": "pair",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Запрос принят",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/common.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/quotes.CreateQuoteRequestResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Некорректная или неподдерживаемая пара",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/quotes/last": {
            "get": {
                "description": "Возвращает последнее сохранённое значение цены и время обновления по валютной паре",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Получить последнее значение котировки",
                "parameters": [
                    {
                        "type": "string",
                        "example": "EUR/MXN",
                        "description": "Валютная пара BASE/QUOTE",
                        "name": "pair",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Значение котировки",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/common.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/quotes.QuoteResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Некорректная или неподдерживаемая пара",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "404": {
                        "description": "Котировка не найдена",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/quotes/{requestID}": {
            "get": {
                "description": "Возвращает значение цены и время обновления по идентификатору запроса.\nЕсли обработка ещё не завершена — 404 с соответствующей ошибкой.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Получить котировку по идентификатору",
                "parameters": [
                    {
                        "type": "string",
                        "example": "0192f4a0-0000-7000-8000-000000000000",
                        "description": "Идентификатор запроса",
                        "name": "requestID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Значение котировки",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/common.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/quotes.QuoteResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Некорректный идентификатор",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "404": {
                        "description": "Запрос не найден или котировка не готова",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "common.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "boolean"
                },
                "errorText": {
                    "type": "string"
                }
            }
        },
        "quotes.CreateQuoteRequestResponse": {
            "type": "object",
            "properties": {
                "created": {
                    "type": "boolean"
                },
                "createdAt": {
                    "type": "string"
                },
                "requestID": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "quotes.QuoteResponse": {
            "type": "object",
            "properties": {
                "pair": {
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        }
    }
}