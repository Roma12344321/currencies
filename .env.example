SERVER_BIND=:8080
BIND_METRICS=:8081
BIND_HEALTH=:8082

LOGGER_LEVEL=debug
LOGGER_FORMAT=console

POSTGRES_HOST=currencies-postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=currencies
POSTGRES_USER=currencies-user
POSTGRES_PASSWORD=password

WORKER_INTERVAL=5s
WORKER_BATCH=100

EXCHANGE_BASE_URL=https://api.frankfurter.dev/v1
EXCHANGE_TIMEOUT=10s
EXCHANGE_SUPPORTED=EUR,MXN

OTEL_SERVICE_NAME=currencies
OTEL_ENDPOINT=jaeger:4318
